generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Auth & Users ──

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name        String?
  avatarUrl   String?      @map("avatar_url")
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships Membership[]

  @@map("users")
}

model Membership {
  id      String         @id @default(uuid())
  userId  String         @map("user_id")
  orgId   String         @map("org_id")
  orgType MembershipOrg  @map("org_type")
  role    MembershipRole @default(member)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, orgType])
  @@map("memberships")
}

enum MembershipOrg {
  venue
  brand
}

enum MembershipRole {
  owner
  member
}

// ── Core Entities ──

model Venue {
  id                 String     @id @default(uuid())
  name               String
  slug               String     @unique
  logoUrl            String?    @map("logo_url")
  websiteUrl         String?    @map("website_url")
  address            String?
  // Structured business address (Smart Sleeves settings). Also the default
  // ship-to for sleeve orders. `address` above is the legacy one-line field.
  street             String?
  suite              String?
  city               String?
  state              String?
  zip                String?
  iconUrl            String?    @map("icon_url")
  fallbackMessage    String     @default("Check back soon!") @map("fallback_message")
  lastOutreachOpenAt DateTime?  @map("last_outreach_open_at")
  // Per-host outreach sender. `outreachFromEmail` must be an @adgyn.com address
  // (our verified Resend domain) — e.g. "gratitude_cafe@adgyn.com". Falls back
  // to one derived from the slug when null. `outreachFromName` is the From
  // display name (defaults to the venue name) — set it to a person to make
  // outreach read as human rather than the storefront. `outreachReplyTo` is the
  // host's real inbox so replies land with them (we only *send* from adgyn.com).
  outreachFromName   String?    @map("outreach_from_name")
  outreachFromEmail  String?    @map("outreach_from_email")
  outreachReplyTo    String?    @map("outreach_reply_to")
  createdAt          DateTime   @default(now()) @map("created_at")
  campaigns          Campaign[]
  prospects          Prospect[]
  outreachEmails     OutreachEmail[]
  outreachReplies    OutreachReply[]
  smartExperiences   SmartExperience[]
  smartContacts      SmartContact[]
  smartSponsors      SmartSponsor[]
  sleeveOrders       SleeveOrder[]

  @@map("venues")
}

model Brand {
  id             String      @id @default(uuid())
  name           String
  websiteUrl     String?     @map("website_url")
  defaultLogoUrl String?     @map("default_logo_url")
  createdAt      DateTime    @default(now()) @map("created_at")
  placements     Placement[]

  @@map("brands")
}

// ── Campaigns & Placements ──

model Campaign {
  id                String         @id @default(uuid())
  venueId           String         @map("venue_id")
  name              String
  status            CampaignStatus @default(draft)
  maxPlacements     Int            @default(4) @map("max_placements")
  sleeveCount       Int            @default(300) @map("sleeve_count")
  revenueTarget     Int?           @map("revenue_target_cents")
  pricePerPlacement Int?           @map("price_per_placement_cents")
  startedAt         DateTime?      @map("started_at")
  endedAt           DateTime?      @map("ended_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  venue      Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  placements Placement[]
  scans      Scan[]

  @@map("campaigns")
}

enum CampaignStatus {
  draft
  active
  completed
}

model Placement {
  id          String          @id @default(uuid())
  campaignId  String          @map("campaign_id")
  brandId     String          @map("brand_id")
  slot        Int
  logoUrl     String?         @map("logo_url")
  tagline     String
  ctaText     String          @map("cta_text")
  ctaUrl      String          @map("cta_url")
  buttonColor String          @default("#1a1a1a") @map("button_color")
  status      PlacementStatus @default(pending)
  createdAt   DateTime        @default(now()) @map("created_at")

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  clicks      Click[]
  conversions Conversion[]

  @@unique([campaignId, slot])
  @@map("placements")
}

enum PlacementStatus {
  pending
  active
  completed
}

// ── Outreach (host prospecting) ──

// A business the venue might recruit as a guest/brand. Populated manually by
// the adgyn team for now (no import / AI research yet) — the point of v1 is to
// learn whether hosts actually work these leads before we automate sourcing.
model Prospect {
  id              String         @id @default(uuid())
  venueId         String         @map("venue_id")
  businessName    String         @map("business_name")
  address         String?
  city            String?
  phone           String?
  website         String?
  contactName     String?        @map("contact_name")
  contactTitle    String?        @map("contact_title")
  email           String?
  // Host's own scratchpad notes while working the lead.
  notes           String?
  // Suggested outreach copy. We fill this in; the UI falls back to a template
  // built from venue + contact names when null.
  outreachMessage String?        @map("outreach_message")
  status          ProspectStatus @default(new)
  statusUpdatedAt DateTime       @default(now()) @map("status_updated_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  venue   Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  emails  OutreachEmail[]
  replies OutreachReply[]

  @@index([venueId])
  @@map("prospects")
}

enum ProspectStatus {
  new
  contacted
  interested
  won
  lost
}

// One row per email actually sent from the outreach module. Doubles as the
// audit log and the source for the per-host daily send cap (count rows for a
// venue since UTC midnight). A row exists only on a successful send, so a
// failed send never burns quota.
model OutreachEmail {
  id         String   @id @default(uuid())
  venueId    String   @map("venue_id")
  prospectId String   @map("prospect_id")
  toEmail    String   @map("to_email")
  fromEmail  String   @map("from_email")
  replyTo    String?  @map("reply_to")
  subject    String
  body       String
  sentAt     DateTime @default(now()) @map("sent_at")

  venue    Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([venueId, sentAt])
  @@index([prospectId])
  @@map("outreach_emails")
}

// A reply received to a venue's @adgyn.com outreach address, delivered by
// Resend's inbound `email.received` webhook. `prospectId` is null when we can't
// match the sender to a known prospect (surfaced in the admin view for triage).
// `providerId` dedupes webhook retries.
model OutreachReply {
  id         String   @id @default(uuid())
  venueId    String   @map("venue_id")
  prospectId String?  @map("prospect_id")
  providerId String?  @unique @map("provider_id")
  fromEmail  String   @map("from_email")
  toEmail    String   @map("to_email")
  subject    String?
  text       String?
  html       String?
  receivedAt DateTime @default(now()) @map("received_at")

  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  prospect Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  @@index([venueId, receivedAt])
  @@index([prospectId])
  @@map("outreach_replies")
}

// ── Invites ──

model Invite {
  id        String        @id @default(uuid())
  token     String        @unique
  orgId     String        @map("org_id")
  orgType   MembershipOrg @map("org_type")
  role      MembershipRole @default(owner)
  email     String?
  usedBy    String?       @map("used_by")
  usedAt    DateTime?     @map("used_at")
  expiresAt DateTime      @map("expires_at")
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("invites")
}

// ── Analytics ──

model Scan {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  visitorId   String?  @map("visitor_id")
  sessionHash String?  @map("session_hash")
  userAgent   String?  @map("user_agent")
  city        String?
  region      String?
  country     String?
  postalCode  String?  @map("postal_code")
  isp         String?
  isMobile    Boolean? @map("is_mobile")
  isProxy     Boolean? @map("is_proxy")
  deviceType  String?  @map("device_type")
  os          String?
  browser     String?
  language    String?
  referrer    String?
  isReturning Boolean  @default(false) @map("is_returning")
  isBot       Boolean  @default(false) @map("is_bot")
  botReason   String?  @map("bot_reason")
  source      String?  // scan surface: e.g. "table-topper"; null/"sleeve" = coffee sleeve
  scannedAt   DateTime @default(now()) @map("scanned_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([visitorId])
  @@map("scans")
}

model Click {
  id          String   @id @default(uuid())
  placementId String   @map("placement_id")
  visitorId   String?  @map("visitor_id")
  sessionHash String?  @map("session_hash")
  userAgent   String?  @map("user_agent")
  city        String?
  region      String?
  country     String?
  postalCode  String?  @map("postal_code")
  isp         String?
  isMobile    Boolean? @map("is_mobile")
  isProxy     Boolean? @map("is_proxy")
  deviceType  String?  @map("device_type")
  os          String?
  browser     String?
  language    String?
  slot        Int?
  dwellMs     Int?     @map("dwell_ms")
  isBot       Boolean  @default(false) @map("is_bot")
  botReason   String?  @map("bot_reason")
  clickedAt   DateTime @default(now()) @map("clicked_at")

  placement   Placement    @relation(fields: [placementId], references: [id], onDelete: Cascade)
  conversions Conversion[]

  @@index([placementId])
  @@index([visitorId])
  @@map("clicks")
}

model Conversion {
  id          String   @id @default(uuid())
  clickId     String?  @map("click_id")
  placementId String   @map("placement_id")
  value       Int?     // reported conversion value in cents, if any
  city        String?
  region      String?
  country     String?
  convertedAt DateTime @default(now()) @map("converted_at")

  click     Click?    @relation(fields: [clickId], references: [id], onDelete: SetNull)
  placement Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([placementId])
  @@index([clickId])
  @@map("conversions")
}

// A Smart Sleeves campaign. `config` holds what customers see (kind + content,
// see `Experience` in src/lib/smart-sleeves.ts). Status: draft until
// `launchedAt` is set, then `published` toggles active/paused; `archivedAt`
// hides it.
model SmartExperience {
  id          String         @id @default(uuid())
  venueId     String         @map("venue_id")
  config      Json
  published   Boolean        @default(true)
  launchedAt  DateTime?      @map("launched_at")
  archivedAt  DateTime?      @map("archived_at")
  inviteToken String         @unique @default(dbgenerated("(gen_random_uuid())::text")) @map("invite_token")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  venue       Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  events      SmartEvent[]
  claims      SmartClaim[]
  qrCodes     SmartQrCode[]
  contacts    SmartContact[]
  sponsors    SmartSponsor[]
  orders      SleeveOrder[]

  @@index([venueId])
  @@map("smart_experiences")
}

// One printed/placed QR code. A campaign has several (sleeve, A-frame, Wi-Fi
// sign…) so each placement is tracked separately. Scans hit /q/<qr id>.
model SmartQrCode {
  id           String          @id @default(uuid())
  experienceId String          @map("experience_id")
  name         String
  placement    String
  label        String          @default("")
  archivedAt   DateTime?       @map("archived_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  experience   SmartExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  events       SmartEvent[]

  @@index([experienceId])
  @@map("smart_qr_codes")
}

model SmartEvent {
  id           String          @id @default(uuid())
  experienceId String          @map("experience_id")
  kind         String
  channel      String
  sessionKey   String          @map("session_key")
  qrCodeId     String?         @map("qr_code_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  experience   SmartExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  qrCode       SmartQrCode?    @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  @@index([experienceId, kind, channel, createdAt])
  @@index([sessionKey, createdAt])
  @@index([qrCodeId])
  @@map("smart_events")
}

model SmartClaim {
  id           String          @id @default(uuid())
  experienceId String          @map("experience_id")
  visitorKey   String          @map("visitor_key")
  headline     String
  business     String
  expiresOn    String          @map("expires_on")
  createdAt    DateTime        @default(now()) @map("created_at")
  redeemedAt   DateTime?       @map("redeemed_at")
  experience   SmartExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, visitorKey])
  @@index([experienceId, createdAt])
  @@map("smart_claims")
}

// A customer who signed up through a newsletter or loyalty campaign.
model SmartContact {
  id           String           @id @default(uuid())
  venueId      String           @map("venue_id")
  experienceId String?          @map("experience_id")
  name         String           @default("")
  email        String
  phone        String           @default("")
  createdAt    DateTime         @default(now()) @map("created_at")
  venue        Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  experience   SmartExperience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)

  // One row per person per campaign, so a regular who joins the newsletter
  // and the loyalty list shows up in both.
  @@unique([experienceId, email])
  @@index([venueId])
  @@map("smart_contacts")
}

// A local business on a campaign's Community Board. Created by the café
// ("invited") or by the business through the campaign invite link
// ("requested"); goes live once the café approves it. No Stripe in V1 — the
// café marks a sponsorship paid by hand. `priceCents` 0 = free placement.
model SmartSponsor {
  id           String          @id @default(uuid())
  venueId      String          @map("venue_id")
  experienceId String          @map("experience_id")
  token        String          @unique @default(dbgenerated("(gen_random_uuid())::text"))
  status       String          @default("invited")
  businessName String          @map("business_name")
  email        String
  priceCents   Int             @default(0) @map("price_cents")
  offer        String          @default("")
  url          String          @default("")
  logoUrl      String?         @map("logo_url")
  paidAt       DateTime?       @map("paid_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  venue        Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  experience   SmartExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
  @@map("smart_sponsors")
}

// A sleeve order request. No online payment in V1: the Adgyn team is emailed,
// invoices the café, and moves `status` along from /admin/sleeve-orders.
model SleeveOrder {
  id            String          @id @default(uuid())
  venueId       String          @map("venue_id")
  experienceId  String          @map("experience_id")
  quantity      Int
  size          String
  design        String
  instructions  String          @default("")
  subtotalCents Int             @map("subtotal_cents")
  shippingCents Int             @map("shipping_cents")
  taxCents      Int             @map("tax_cents")
  totalCents    Int             @map("total_cents")
  shipTo        String          @map("ship_to")
  status        String          @default("requested")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  venue         Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  experience    SmartExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@map("sleeve_orders")
}
