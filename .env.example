# Copy to .env and fill in values from Supabase dashboard

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Prisma (Supabase PostgreSQL) ──
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-us-west-1.pooler.supabase.com:5432/postgres"

# ── Email (Resend) — invite emails ──
# Get a free API key at https://resend.com (Free tier: 3,000 emails/mo).
# If RESEND_API_KEY is unset, invite emails are skipped and links are shared manually.
RESEND_API_KEY=re_xxxxxxxx
# Sending identity. Once adgyn.com is verified in Resend the default works.
# Before verifying a domain, use onboarding@resend.dev (sends only to your own account email).
RESEND_FROM="Adgyn <invites@adgyn.com>"
# Base URL used to build invite links in emails (defaults to https://app.adgyn.com).
NEXT_PUBLIC_APP_URL=https://app.adgyn.com
